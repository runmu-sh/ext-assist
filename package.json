{
  "name": "@runmu.sh/ext-assist",
  "version": "1.2.0",
  "description": "The staff help desk: account-keyed help threads with claim, status and replies, driven by GMCP Client.Assist.* or another extension's API.",
  "keywords": [
    "assist",
    "help",
    "staff",
    "gmcp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/assist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-assist.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-assist/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./src/types.ts",
  "files": [
    "dist",
    "src/types.ts",
    "schema",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "assist",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Assist",
    "description": "The staff help desk: account-keyed help threads with claim, status and replies, driven by GMCP Client.Assist.* or another extension's API.",
    "categories": [
      "interface",
      "communication"
    ],
    "contributes": {
      "panels": [
        {
          "id": "assist",
          "title": "Assist"
        }
      ],
      "gmcp": [
        {
          "package": "Client.Assist 1",
          "messages": {
            "Client.Assist.Inbox": {
              "dir": "in",
              "schema": "schema/inbox.json"
            },
            "Client.Assist.Thread": {
              "dir": "in",
              "schema": "schema/thread.json"
            },
            "Client.Assist.Message": {
              "dir": "in",
              "schema": "schema/message.json"
            },
            "Client.Assist.Action": {
              "dir": "out",
              "schema": "schema/action.json"
            }
          }
        }
      ]
    },
    "capabilities": [
      "send-commands"
    ],
    "publisher": "bitmuse"
  }
}
