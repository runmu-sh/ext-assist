{
  "name": "@runmu.sh/ext-assist",
  "version": "1.1.1",
  "description": "The staff help desk: account-keyed help threads with claim, status and replies, driven by GMCP Client.Assist.* or another extension's API.",
  "keywords": [
    "assist",
    "help",
    "staff",
    "gmcp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/assist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-assist.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-assist/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./src/types.ts",
  "files": [
    "dist",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.6.0",
    "@runmu.sh/dev": "^0.1.0",
    "@runmu.sh/ext-kit": "^1.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "assist",
    "api": "^1.5",
    "source": "src/index.ts",
    "displayName": "Assist",
    "description": "The staff help desk: account-keyed help threads with claim, status and replies, driven by GMCP Client.Assist.* or another extension's API.",
    "categories": [
      "interface",
      "communication"
    ],
    "contributes": {
      "panels": [
        {
          "id": "assist",
          "title": "Assist"
        }
      ],
      "gmcp": [
        "Client.Assist 1"
      ]
    },
    "capabilities": [
      "read-output",
      "send-commands"
    ],
    "publisher": "bitmuse"
  }
}
